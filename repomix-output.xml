// src/app/app.js
import { render, navigate } from "./router.js";

export function startApplication() {
    console.log("AI Prompt Suite Infinite v2.0");

    // 1. เนเธซเธฅเธ”เธซเธเนเธฒเน€เธเธเธเธฑเธเธเธธเธเธฑเธ (เธซเธฃเธทเธญเนเธเธ—เธตเน / เธ–เนเธฒเน€เธเธดเนเธเน€เธเธดเธ”เน€เธงเนเธ)
    const currentPath = window.location.pathname || "/";
    render(currentPath);

    // 2. เน€เธฃเธดเนเธกเธ•เนเธเธฃเธฐเธเธเธเธฒเธฃเธเธฅเธดเธเน€เธกเธเธน (Event Delegation)
    initNavigation();
}

function initNavigation() {
    // เนเธเน event click เธ—เธตเนเธฃเธฐเธ”เธฑเธ document เน€เธเธทเนเธญเนเธซเนเธเธธเนเธกเธ—เธตเนเธ–เธนเธเธชเธฃเนเธฒเธเนเธซเธกเนเธ—เธณเธเธฒเธเนเธ”เนเน€เธชเธกเธญ
    document.addEventListener("click", (e) => {
        const menuItem = e.target.closest("li[data-path]");
        if (menuItem) {
            const targetPath = menuItem.getAttribute("data-path");
            navigate(targetPath);
            return;
        }

        // เธเธธเนเธกเนเธเนเนเธกเนเนเธเธเธเธฒเธ Library: data-template contains encoded JSON
        const useBtn = e.target.closest("button[data-template]");
        if (useBtn) {
            try {
                const payload = JSON.parse(decodeURIComponent(useBtn.getAttribute('data-template')));
                window.sessionStorage.setItem('selectedTemplate', JSON.stringify(payload));
                // navigate to prompt using history API and trigger router
                window.history.pushState({}, '', '/prompt');
                window.dispatchEvent(new PopStateEvent('popstate'));
            } catch (err) {
                console.error('Failed to load template', err);
            }
            return;
        }

        // เธเธธเนเธกเธเธฑเธ”เธฅเธญเธเธเธณเธชเธฑเนเธเธเธ Library
        const copyBtn = e.target.closest('button[data-copytemplate]');
        if (copyBtn) {
            try {
                const payload = JSON.parse(decodeURIComponent(copyBtn.getAttribute('data-copytemplate')));
                navigator.clipboard.writeText(payload.prompt || '').then(() => {
                    const old = copyBtn.innerText;
                    copyBtn.innerText = 'โ… เธเธฑเธ”เธฅเธญเธเนเธฅเนเธง';
                    setTimeout(() => copyBtn.innerText = old, 1500);
                });
            } catch (err) {
                console.error('Failed to copy template', err);
            }
            return;
        }
    });

    // เธฃเธญเธเธฃเธฑเธเธเธธเนเธก Back / Forward เธเธเน€เธเธฃเธฒเธงเนเน€เธเธญเธฃเน
    window.addEventListener("popstate", () => {
        render(window.location.pathname);
    });
}
