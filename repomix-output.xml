    // 4. เธเธฑเธเธ—เธถเธเธเธฃเธฐเธงเธฑเธ•เธด + เธเธฑเธ”เธฅเธญเธ
    if (copyBtn) {
        copyBtn.addEventListener("click", () => {
            const text = outputPrompt?.textContent || "";
            navigator.clipboard.writeText(text).then(() => {
                copyBtn.innerText = "โ… เธเธฑเธ”เธฅเธญเธเนเธฅเนเธง!";
                saveToHistory(getCurrentPromptData());
                showToast("เธเธฑเธ”เธฅเธญเธเน€เธฃเธตเธขเธเธฃเนเธญเธขเนเธฅเนเธง!");
                setTimeout(() => { copyBtn.innerText = "๐“ เธเธฑเธ”เธฅเธญเธเธเธณเธชเธฑเนเธ"; }, 2000);
            });
