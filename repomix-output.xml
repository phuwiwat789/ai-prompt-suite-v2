// เธฃเธฒเธขเธเธฒเธฃเน€เธชเนเธเธ—เธฒเธเนเธฅเธฐเธซเธเนเธฒเน€เธเธเน€เธเนเธฒเธซเธกเธฒเธข
const routes = {
    "/": DashboardPage,
    "/dashboard": DashboardPage,
    "/prompt": PromptPage,
    "/creator": CreatorPage,
    "/coding": CodingPage,
    "/library": LibraryPage,
    "/favorite": FavoritePage,
    "/history": HistoryPage,
    "/settings": SettingsPage,
    "/languages": LanguagesPage
};

// เธเธฑเธเธเนเธเธฑเธเธชเธณเธซเธฃเธฑเธเน€เธเธฅเธตเนเธขเธเธซเธเนเธฒ (เนเธเนเน€เธเธทเนเธญเธกเธ•เนเธญเธเธฑเธเธเธธเนเธกเน€เธกเธเธนเนเธ Sidebar)
export function navigate(path) {
    window.history.pushState({}, path, window.location.origin + path);
    render(path);
}

// เธเธฑเธเธเนเธเธฑเธเธซเธฅเธฑเธเธชเธณเธซเธฃเธฑเธเนเธชเธ”เธเธเธฅเนเธฅเธฐเธเธงเธเธเธธเธกเธซเธเนเธฒเน€เธเธ
export function render(path) {
    // 1. เธ•เธฃเธงเธเธชเธญเธเธงเนเธฒเธกเธตเธซเธเนเธฒเน€เธเธเธเธฑเนเธเธซเธฃเธทเธญเนเธกเน (เธ–เนเธฒเนเธกเนเธกเธตเนเธซเนเนเธเธซเธเนเธฒ NotFound)
    const pageComponent = routes[path] || NotFound;
    const contentHtml = typeof pageComponent === "function" ? pageComponent() : "<h1>Page Error</h1>";
    
    // 2. เธเธณเน€เธเธทเนเธญเธซเธฒเธกเธฒเนเธชเนเนเธ Layout เธซเธฅเธฑเธ (เธกเธต Navbar & Sidebar)
    const appContainer = document.getElementById("app") || document.body;
    appContainer.innerHTML = MainLayout(contentHtml);
    
    // 3. โญ เธ•เธฃเธงเธเธชเธญเธ Path: เธซเธฒเธเน€เธเธดเธ”เธซเธเนเธฒ Prompt Builder เนเธซเนเน€เธเธดเธ”เนเธเนเธเธฒเธเธเธฑเธเธเนเธเธฑเธเนเธ•เนเธ•เธญเธเธ—เธฑเธเธ—เธต
    if (path === "/prompt") {
        initPromptBuilder();
    } else if (path === "/creator") {
        initCreatorBuilder();
    } else if (path === "/coding") {
        initCodingBuilder();
    }

    // เธ–เนเธฒเน€เธเธดเธ”เธซเธเนเธฒ Library เนเธซเนเน€เธฃเธตเธขเธเธ•เธฑเธงเธเธฑเธ”เธเธฒเธฃ Library
    if (path === "/library") {
        initLibraryBuilder();
    }

    // เธ–เนเธฒเน€เธเธดเธ”เธซเธเนเธฒ Favorite เนเธซเนเน€เธฃเธตเธขเธเธ•เธฑเธงเธเธฑเธ”เธเธฒเธฃ Favorite
    if (path === "/favorite") {
        initFavoriteBuilder();
    }

    // เธ–เนเธฒเน€เธเธดเธ”เธซเธเนเธฒ History เนเธซเนเน€เธฃเธตเธขเธเธ•เธฑเธงเธเธฑเธ”เธเธฒเธฃ History
    if (path === "/history") {
        initHistoryBuilder();
    }

    // เธ–เนเธฒเน€เธเธดเธ”เธซเธเนเธฒ Languages เนเธซเนเน€เธฃเธตเธขเธเธ•เธฑเธงเธเธฑเธ”เธเธฒเธฃเธ เธฒเธฉเธฒ
    if (path === "/languages") {
        initLanguageManager();
    }
}

// เธเธฑเธเธเนเธเธฑเธเธชเธณเธซเธฃเธฑเธเน€เธฃเธตเธขเธเนเธซเธฅเธ”เธซเธเนเธฒเน€เธฃเธดเนเธกเธ•เนเธ
export function loadPage(path) {
    // เธเธฃเธฑเธเธฃเธนเธเนเธเธ path เนเธซเนเธกเธต "/" เธเธณเธซเธเนเธฒเน€เธชเธกเธญเน€เธเธทเนเธญเธเธงเธฒเธกเธ–เธนเธเธ•เนเธญเธเธเธญเธเธฃเธฐเธเธ routes
    const formattedPath = path.startsWith("/") ? path : `/${path}`;
